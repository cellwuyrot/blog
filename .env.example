# Public base URL, without a trailing slash
SITE_URL=https://acoulbot.space
# Use 0 for local HTTP; use 1 for production HTTPS
COOKIE_SECURE=1
# Set 1 only behind a trusted reverse proxy that overwrites forwarded headers
TRUST_PROXY=1
# Optional. Paste verification token content, not an HTML tag.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Optional. Loaded only after visitor consent.
GA_MEASUREMENT_ID=
YANDEX_METRIKA_ID=
# Optional Spotify owner OAuth; secrets stay server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://acoulbot.space/api/spotify/callback
